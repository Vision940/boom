  elif [[ "$1" == "_bot" ]]; then term="${@:2}"
  else term="$@"
  fi

  local plural=""
  (( score > 1 )) && plural="s"
  if [[ "$1" == "_bot" ]]; then
    echo "$_BE_BOT BoomBot thinks $term is $score big boom${plural}! $result"
    return
  fi
  local prefix="Let's rank it on the"
  $logrun && prefix=Random
  echo "$prefix ${mult:+SUPER }boom meter! $term gets ${dispscore}${mult:+x$mult} big boom${plural}! $result"
  if ! $logrun; then
  #  echo "$USER's ranking it on the boom meter! $term gets $score big boom${plural}! $result" >> $_boommeterLog
    :
  fi
  if [[ ! "$term" =~ "/" && -f "$_boomRankings" ]]; then
    grep -q "^ $term " $_boomRankings && __boomavg $term
  fi
  if $logrun && [[ -f "$_boomStreak" ]]; then __boomhog $term; fi
  if $logrun && __boomvar active BOOMBOTMODE; then _bbmHandler $score; fi
}

###Function doommeter
# "\t${B}doommeter${N} THING";
# "\t\tthis function ranks THING on the doommeter...";
###
doommeter() {
  __doom 127 || return

  if [ -z "$1" ]; then
    echo "Give us something to rank on the doom meter..."
    return 1
  fi

  local score=$(( RANDOM % 8 - 2 ))
  local result=""

  (( score < 1 )) && score=1

  local i
  for (( i=0; i<score; i++ )); do
    result+="$_BE_HOLE"
  done

  local plural=""
  (( score > 1 )) && plural="s"
  echo "Let's rank it on the doom meter... $@ gets $score big doom${plural}. $result"
  #echo "$USER's ranking it on the doom meter... $@ gets $score big doom${plural}. $result" >> $_boommeterLog
}

###Function boomavg
# "\t${B}boomavg${N} [CMD]";
# "\t\tthis function prints your average rank and total booms for every command!";
# "\t\tif CMD arg present, function will only print avg for CMD";
###
boomavg() {
  __doom 127 || return

  if [[ -n "$1" ]]; then
    if [[ -n "$(_boomavg $1)" ]]; then __boomavg "$1"
    else echo "$1 not found in averages!"; fi
  else
    #TODO: better way here?
    while read line; do
      __boomavg ${line[0]}
    done < $_boomRankings
  fi
}
__gs_boom_action() {
  local action args trash
  local cmd ranking
  local line

  read -r action args <<<"$@"
  case _${action}_ in
    _RANK_)
      read -r cmd ranking trash <<<"$args"
      __gs_required_args -q cmd ranking && line="$action $cmd $ranking"
    ;;
  esac
  [[ -n "$line" ]] && echo "$line" >> $_boomActionCache
}

__boomlog() {
  local cmd="${1//\\}"

  # Extra filter to be safe (for a while this was single-handedly saving us)
  [[ "$cmd" =~ [!./[\"\']+ ]] && return

  __gs_boom_action RANK "$cmd" "$2"

  # Create rankings if non-existent
  if [[ ! -f "$_boomRankings" ]]; then
    echo " $cmd $2" > $_boomRankings
    command chmod 644 $_boomRankings &>/dev/null
    return
  fi

  local exists=$(sed -ne "/^ $cmd /p" $_boomRankings)
  if [[ -n "$exists" ]]; then
    sed -i "/^ $cmd / s|$| $2|" $_boomRankings
  else
    sed -i "$ a \ $cmd $2" $_boomRankings
  fi
  #echo $USER boomed $cmd for $2 boom$([ $2 -gt 1 ] && echo s)${3:+ on $3}! >> $_boomUserLog
}
__boomavg() {
  local sum count avg
  grep -q "^ $1 " $_boomRankings || return
  for num in $(sed -n "s|^ $1 ||p" $_boomRankings); do
    sum=$((sum+num))
    count=$((count+1))
  done
  __gs_calc -d 2 -r avg "$sum/$count"

  local plural=""
  (( count > 1 )) && plural="s"
  echo "$1 has an average of $avg booms after $count hit${plural}!"
}
__boomhog() {
  if [[ "$(cat $_boomStreak) " =~ " $1 " ]]; then
    echo -n " $1" >> $_boomStreak
  else
    echo -n " $1" > $_boomStreak
    command chmod 644 $_boomStreak &>/dev/null
  fi

  local streak=$(wc -w <$_boomStreak)
  if (( streak >= 2 )); then
    echo $_BE_BOOM$_BE_HOG$_BE_BOOM BOOM HOG! $1 is on a random boom streak of $streak in a row! $_BE_BOOM$_BE_HOG$_BE_BOOM
    #echo $_BE_BOOM$_BE_HOG$_BE_BOOM BOOM HOG! $USER\'s $1 hit a random boom streak of $streak! $_BE_BOOM$_BE_HOG$_BE_BOOM >> $_boomUserLog
  fi
  [[ -n "$BOOMSTATTRACKING" ]] && _boomStatComp $USER 13 $streak
}

__gs_boom_comp() {
  return 1
