__boomcmdno() {
  export $1=$(printf '%s' "${BOOM_MAGICPROMPT@P}")
}

__boomvar() {
  local action="$1" var="$2"
  case _${action}_ in
    _activate_)
      export $var="yes"
    ;;
    _active_)
      [[ "${!var}" == "yes" ]]
      return
    ;;
    _inactive_)
      [[ "${!var}" != "yes" ]]
      return
    ;;
  esac
}
__doom() {
  local action="$1"
  case _${action}_ in
    _127_)
      if __doom active; then
        echo bash: ${FUNCNAME[-1]}: command not found
        return 127
      fi
      return 0
    ;;
    _activate_) ;&
    _active_) ;&
    _inactive_)
      __boomvar $action DOOMBOOM
      return
    ;;
    _file-access_)
      [[ ! -w "$2" ]] && __boomvar activate DOOMBOOM
    ;;
    _persist_)
      if [[ -w "$_doomTracker" ]] && __doom tracker-oos; then
        if [[ "$(cat $_doomTracker 2>/dev/null)" =~ "yes" ]]; then
          clear
        else
          export AUTOBOOMBOT=
          echo $_BE_BOOM$_BE_BOOM WE BRING THE BOOM $_BE_BOOM$_BE_BOOM
        fi
        DOOMBOOM=$(cat $_doomTracker)
      fi
    ;;
    _tracker-oos_)
      # Is the tracker out of state?
      [[ "$(cat $_doomTracker 2>/dev/null)" != "$DOOMBOOM" ]]
      return
    ;;
  esac
}

