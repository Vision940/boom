bang() {
  __doom 127 || return
  local i
  for (( i=0; i<${1:-1}; i++ )); do echo -n ${_BE_BOOM}; done; echo
}

__boom_action() {
  local action args trash
  local line

  read -r action args <<<"$@"
  case _${action}_ in
    _RANK_)
      local cmd ranking multiplier odds host import quest drought
      read -r cmd ranking multiplier odds host import quest drought trash <<<"$args"
      __gs_required_args -q cmd ranking && line="$action $cmd $ranking ${multiplier:-1} ${odds:-15} ${host:-${HOSTNAME:-unknown}} ${import:-FALSE} ${quest:-FALSE}${drought:+ $drought}"
    ;;
    _CHATLOG_) ;&
    _BOOMLOG_)
      #TODO: BOOMLOG should just be derived from base principles in the backend once db is populated
      #TODO: CHATLOG should use gameserver chat feature with a 'boom' room
      #TODO: chat timeout table with chat feature or maybe install wide user timeouts
      local phrase="$args"
      __gs_required_args -q phrase && line="$action $phrase"
    ;;
  esac
  local now=${EPOCHSECONDS:-$(date +%s)}
  [[ -n "$line" ]] && echo "$now $line" >> $_boomActionCache
}

__boommeter() {
  # This magic skips empty lines
  __boomcmdno BOOM_CMDNO
  if (( BOOM_CMDNO == BOOMPREV_CMDNO )); then return; fi

  local cmd=$(fc -ln -1 | head -n 1 | awk '{print $1}')
  local cmd="${cmd//\\}"

  if [[ -n "$cmd" ]]; then
    local odds=15
    if (( RANDOM % odds == 7 )); then
      __boommeter_roll "$cmd" _log_
    fi
  fi

  BOOMPREV_HISTCMD=$HISTCMD
  BOOMPREV_CMDNO=$BOOM_CMDNO
}

__boommeter_roll() {
  local cmd="$1"
  local runner="$2"

  local prefix="Let's rank it on the boom meter! "
  case _${runner}_ in
    __log__)
      [[ "$cmd" =~ [!./[\"\']+ ]] && return
      prefix="Random boom meter! "
    ;;
    __bot__) prefix="BoomBot thinks " ;;
  esac

  #TODO: detect supers here
  local score=$(( RANDOM % 8 + 1 ))
  (( score > 5 )) && score=5
  (( RANDOM % 500 == 365 )) && score=6

  local plural=""
  (( score > 1 )) && plural="s"

  local emojis="$(bang $score)"
  local suffix="gets $score big boom${plural}! $emojis"

  case _${runner}_ in
    __bot__)
      __boom_action CHATLOG "${prefix}$cmd ${suffix/gets/is}"
    ;;
    __cmd__)
      echo "${prefix}$cmd $suffix"
      prefix="$GS_USER is ranking it on the boom meter! "
      __boom_action CHATLOG "${prefix}$cmd $suffix"
    ;;
    __log__)
      echo "${prefix}$cmd $suffix"
      __boomlog "$cmd" "$score" #TODO: mult
    ;;
  esac
}
__boomlog() {
  #TODO: read mult, host, odds?, quest, drought, and whatever else with read from args 3+
  local cmd="$1" score="$2" host="$3"
  local plural=""

  #TODO: super boom mult should be passed in
  local mult=1
  (( score*mult > 1 )) && plural="s"

  #TODO: favorite odds
  local odds=15

  #TODO: boom drought
  local drought=0

  #TODO: boom quest
  local quest=FALSE

  # Log boom event to site
  __boom_action BOOMLOG "$GS_USER boomed $cmd for $((score*mult)) boom${plural}${host:+ on $host}!"

  # Boom is an import if host is populated here
  local import=FALSE
  [[ -n "$host" ]] && import=TRUE

  # Log ranking if no problematic chars
  [[ "$1" =~ ^[^!/.[\"\']+$ ]] && __boom_action RANK "$cmd" "$score" "$mult" "$odds" "${host:-${HOSTNAME:-unknown}}" "$import" "$quest" "$drought"
}

boommeter() {
  __doom 127 || return
  local phrase="$*"
  if [[ -n "$phrase" ]]; then
    __boommeter_roll "$phrase" _cmd_
  else
    echo "Give us something to rank on the boom meter!"
  fi
}

